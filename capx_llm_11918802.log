import numpy as np

tube = get_task()["tube"]
bottom, top = get_tube_pose(tube)
axis = top[:2] - bottom[:2]
length = np.linalg.norm(axis)
unit = axis / length
center = (bottom + top) / 2
yaw = float(np.arctan2(axis[1], axis[0]))

# Grip near one end, so the vial can swing down under gravity when lifted.
grasp = center.copy()
grasp[:2] += unit * (length * 0.32)

set_gripper("right", 0.082)
if not move_to("right", np.array([grasp[0], grasp[1], grasp[2]]),
