import numpy as np

task = get_task()
tube = task["tube"]
dest_cell = tuple(task["dest_cell"])

source = get_rack("rack_source")
dest = get_rack("rack_dest")
bottom, top = get_tube_pose(tube)

arm = "right"
grasp_offset = 0.055
grasp_yaw = source["yaw"]
dest_yaw = dest["yaw"]

set_gripper(arm, 0.082)

# Approach above the vial, then descend to grip above the rack wall.
approach = np.array([bottom[0], bottom[1], bottom[2] + 0.105])
grasp = np.array([bottom[0], bottom[1], bottom[2] + grasp_offset])
if not move_to(arm, approach, yaw=grasp_yaw, tilt=0.0, speed=0.08):
    raise RuntimeError("Could not reach the vial approach position")
if not move_to(arm, grasp, yaw=grasp_yaw, tilt=0.0, speed=0.05):
    raise RuntimeError("Could not reach the vial grasp position")

set_gripper(arm, 0.0)

# Lift clear of the rack before moving laterally.
lift = np.array([bottom[0], bottom[1], 0.149])
if not move_to(arm, lift, yaw=grasp_yaw, tilt=0.0, speed=0.06):
    raise RuntimeError("Could not lift the vial clear of the source rack")

cell_bottom = np.asarray(dest["cells"][dest_cell])
transit = np.array([cell_bottom[0], cell_bottom[1], 0.149])
if not move_to(arm, transit, yaw=dest_yaw, tilt=0.0, speed=0.08):
    raise RuntimeError("Could not move the vial over the destination cell")

# Lower until the vial is seated, then release and retreat.
insert = np.array([cell_bottom[0], cell_bottom[1], cell_bottom[2] + grasp_offset])
if not move_to(arm, insert, yaw=dest_yaw, tilt=0.0, speed=0.05):
    raise RuntimeError("Could not lower the vial into the destination cell")

set_gripper(arm, 0.082)
retreat = np.array([cell_bottom[0], cell_bottom[1], 0.149])
