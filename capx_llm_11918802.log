import numpy as np

tube = "tube_1"
target = np.asarray(get_rack("rack_dest")["cells"][(2, 1)], dtype=float)
bottom, top = get_tube_pose(tube)
gripper = get_gripper_pose("right")
pos = np.asarray(gripper["pos"], dtype=float)

# Keep the vial's current height and shift it horizontally over the target;
# releasing from just above the rack floor lets it settle into the cell.
shift = target[:2] - bottom[:2]
approach = pos + np.array([shift[0], shift[1], 0.05])
if not move_to("right", approach, yaw=float(gripper["yaw"]), speed=0.06):
    raise RuntimeError("Could not lift the held vial")
release_pos = approach - np.array([0.0, 0.0, 0.05])
if not move_to("right", release_pos, yaw=float(gripper["yaw"]), speed=0.05):
    raise RuntimeError("Could not position the vial over the target")
set_gripper("right", 0.082)
go_home("right")

