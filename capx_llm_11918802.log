import numpy as np

task = get_task()
tube = task["tube"]
rack = get_rack("rack_dest")
dest_bottom = np.asarray(rack["cells"][task["dest_cell"]], dtype=float)
tube_bottom, _ = get_tube_pose(tube)
gripper = get_gripper_pose("right")
offset = np.asarray(gripper["pos"], dtype=float) - tube_bottom
target = dest_bottom + offset

# The previous descent stopped above the rack wall. Retry with tiny lateral
# alignment adjustments, returning to a clear height after any blocked attempt.
candidates = [
    (0.0, 0.0),
    (0.001, 0.0), (-0.001, 0.0),
    (0.0, 0.001), (0.0, -0.001),
    (0.001, 0.001), (0.001, -0.001),
    (-0.001, 0.001), (-0.001, -0.001),
]

for dx, dy in candidates:
    p = target.copy()
    p[0] += dx
    p[1] += dy
    clear = p.copy()
    clear[2] += 0.075

    if not move_to("right", clear, yaw=rack["yaw"], speed=0.05):
        continue
    if not move_to("right", p + np.array([0.0, 0.0, 0.04]),
                   yaw=rack["yaw"], speed=0.035):
        continue

    seated = True
    for dz in (0.02, 0.01, 0.0):
        waypoint = p.copy()
        waypoint[2] += dz
        if not move_to("right", waypoint, yaw=rack["yaw"], speed=0.025):
            seated = False
            break

    if seated:
        set_gripper("right", 0.082)
        retreat = p.copy()
        retreat[2] += 0.10
        move_to("right", retreat, yaw=rack["yaw"], speed=0.05)
        go_home("right")
        print("Vial placed and released.")
        break

    move_to("right", clear, yaw=rack["yaw"], speed=0.04)
else:
    print("Could not complete destination insertion; vial remains held.")

