# Code block 0
import numpy as np

task = get_task()
tube = task["tube"]
dest_cell = task["dest_cell"]

bottom, top = get_tube_pose(tube)
source = get_rack("rack_source")
dest = get_rack("rack_dest")

grip_offset = (top - bottom) / 2
grip_height = float(np.linalg.norm(grip_offset))
source_grip = bottom + grip_offset
dest_bottom = np.asarray(dest["cells"][dest_cell], dtype=float)
dest_grip = dest_bottom + grip_offset

arm = "right"
yaw = float(source["yaw"])

set_gripper(arm, 0.082)

# Approach and grasp the vial around its midpoint.
if not move_to(arm, source_grip + np.array([0.0, 0.0, 0.10]), yaw=yaw):
    raise RuntimeError("Could not reach the source approach pose")
if not move_to(arm, source_grip, yaw=yaw, speed=0.05):
    raise RuntimeError("Could not reach the source grasp pose")
set_gripper(arm, 0.0)

# Lift clear of the source rack before traversing to the destination.
if not move_to(arm, source_grip + np.array([0.0, 0.0, 0.10]), yaw=yaw, speed=0.06):
    raise RuntimeError("Could not lift the vial")

# Lower the vial until its bottom is seated at the target cell.
dest_approach = dest_grip + np.array([0.0, 0.0, 0.10])
if not move_to(arm, dest_approach, yaw=float(dest["yaw"]), speed=0.08):
    raise RuntimeError("Could not reach the destination approach pose")
if not move_to(arm, dest_grip, yaw=float(dest["yaw"]), speed=0.05):
    raise RuntimeError("Could not insert the vial into the destination cell")

set_gripper(arm, 0.082)
go_home(arm)

