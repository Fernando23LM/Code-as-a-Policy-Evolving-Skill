set_gripper(arm, 0.082)

retreat = target_grasp.copy()
retreat[2] = 0.14
if not move_to(arm, retreat, yaw=dest_yaw, tilt=0.0, speed=0.06):
    raise RuntimeError("Could not retreat from the destination cell.")

go_home(arm)


