import numpy as np

task = get_task()
tube = task["tube"]
ix, iy = task["dest_cell"]
source = get_rack("rack_source")
dest = get_rack("rack_dest")
bottom, top = get_tube_pose(tube)

def move(position, yaw, speed=0.12):
    if not move_to("right", np.asarray(position, dtype=float), yaw=yaw, tilt=0.0, speed=speed):
        raise RuntimeError("Arm could not reach the requested pose")

tube_xy = (np.asarray(bottom)[:2] + np.asarray(top)[:2]) / 2
grasp_z = float(bottom[2]) + 0.045
pick_yaw = source["yaw"]
set_gripper("right", 0.082)
move([tube_xy[0], tube_xy[1], grasp_z + 0.06], pick_yaw)
move([tube_xy[0], tube_xy[1], grasp_z], pick_yaw, speed=0.06)
set_gripper("right", 0.0)

lift_z = grasp_z + 0.07
move([tube_xy[0], tube_xy[1], lift_z], pick_yaw, speed=0.06)

target = np.asarray(dest["cells"][(ix, iy)], dtype=float)
place_z = float(target[2]) + (grasp_z - float(bottom[2]))
place_yaw = dest["yaw"]
move([target[0], target[1], lift_z], place_yaw)
move([target[0], target[1], place_z], place_yaw, speed=0.06)
set_gripper("right", 0.082)
move([target[0], target[1], place_z + 0.07], place_yaw, speed=0.06)
go_home("right")


