# Code block 0
import numpy as np

task = get_task()
tube = task["tube"]
dest_ix, dest_iy = task["dest_cell"]

source_rack = get_rack("rack_source")
dest_rack = get_rack("rack_dest")
bottom, top = get_tube_pose(tube)
bottom = np.asarray(bottom, dtype=float)
top = np.asarray(top, dtype=float)
height = float(np.linalg.norm(top - bottom))
grasp_pos = (bottom + top) / 2.0

def move_checked(position, yaw, speed=0.12):
    if not move_to("right", np.asarray(position, dtype=float), yaw=yaw, tilt=0.0, speed=speed):
        raise RuntimeError("Right arm could not reach the requested position.")

set_gripper("right", 0.04)
move_checked(grasp_pos + np.array([0.0, 0.0, 0.06]), source_rack["yaw"])
move_checked(grasp_pos, source_rack["yaw"], speed=0.06)
set_gripper("right", 0.0)

lifted_pos = grasp_pos + np.array([0.0, 0.0, 0.10])
move_checked(lifted_pos, source_rack["yaw"], speed=0.06)

dest_bottom = np.asarray(dest_rack["cells"][(dest_ix, dest_iy)], dtype=float)
dest_center = dest_bottom + np.array([0.0, 0.0, height / 2.0])
dest_yaw = dest_rack["yaw"]
dest_above = dest_center + np.array([0.0, 0.0, 0.10])

move_checked(dest_above, dest_yaw)
move_checked(dest_center, dest_yaw, speed=0.06)
set_gripper("right", 0.082)

move_checked(dest_above, dest_yaw, speed=0.06)
go_home("right")


