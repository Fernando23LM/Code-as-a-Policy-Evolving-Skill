if not move_to(arm, grasp_pos, yaw=source_yaw, tilt=0.0, speed=0.06):
    raise RuntimeError("Could not reach the vial grasp position.")

set_gripper(arm, 0.0)

lifted = grasp_pos.copy()
lifted[2] = 0.14
if not move_to(arm, lifted, yaw=source_yaw, tilt=0.0, speed=0.06):
    raise RuntimeError("Could not lift the vial clear of the source rack.")

target_bottom = np.array(dest_rack["cells"][(ix, iy)], dtype=float)
target_grasp = target_bottom.copy()
target_grasp[2] += grasp_offset

if not move_to(arm, target_grasp, yaw=dest_yaw, tilt=0.0, speed=0.06):
