import numpy as np

task = get_task()
tube = task["tube"]
ix, iy = task["dest_cell"]

source_rack = get_rack("rack_source")
dest_rack = get_rack("rack_dest")
bottom, top = get_tube_pose(tube)

grasp_height = float((bottom[2] + top[2]) / 2.0)
grasp_offset = grasp_height - float(bottom[2])
grasp_pos = np.array([bottom[0], bottom[1], grasp_height], dtype=float)

arm = "right"
source_yaw = source_rack["yaw"]
dest_yaw = dest_rack["yaw"]

go_home(arm)
set_gripper(arm, 0.082)

approach = grasp_pos.copy()
approach[2] = 0.14
