# Code block 0
import numpy as np

task = get_task()
tube = task["tube"]
ix, iy = task["dest_cell"]

bottom, top = get_tube_pose(tube)
source_rack = get_rack("rack_source")
dest_rack = get_rack("rack_dest")

grasp_offset = min(0.052, float(top[2] - bottom[2]) - 0.015)
grasp = np.array([bottom[0], bottom[1], bottom[2] + grasp_offset])

set_gripper("right", 0.082)
assert move_to(
    "right",
    np.array([bottom[0], bottom[1], top[2] + 0.08]),
    yaw=source_rack["yaw"],
)
assert move_to("right", grasp, yaw=source_rack["yaw"], speed=0.06)
set_gripper("right", 0.025)

assert move_to(
    "right",
    np.array([bottom[0], bottom[1], top[2] + 0.10]),
    yaw=source_rack["yaw"],
)
dest_bottom = np.array(dest_rack["cells"][(ix, iy)])
assert move_to(
    "right",
    np.array([dest_bottom[0], dest_bottom[1], top[2] + 0.10]),
    yaw=dest_rack["yaw"],
)
assert move_to(
    "right",
    np.array([dest_bottom[0], dest_bottom[1], dest_bottom[2] + grasp_offset]),
    yaw=dest_rack["yaw"],
    speed=0.05,
)
set_gripper("right", 0.082)
assert move_to(
    "right",
    np.array([dest_bottom[0], dest_bottom[1], dest_bottom[2] + 0.12]),
    yaw=dest_rack["yaw"],
)
go_home("right")


